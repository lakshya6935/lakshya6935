# Rename this file to .env before running the server

# MongoDB connection string (local MongoDB by default)
MONGO_URI=mongodb://localhost:27017/hotel_management

# Secret key used to sign JWT tokens - change this to a long random string in production
JWT_SECRET_KEY=change-this-super-secret-key-in-production

# Default admin account created automatically by seed.py
DEFAULT_ADMIN_EMAIL=admin@stayluxe.com
DEFAULT_ADMIN_PASSWORD=Admin@12345

# Flask environment
FLASK_ENV=development
PORT=5000
